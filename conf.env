# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Primary PostgreSQL connection string for the main application
# This should point to your PostgreSQL VM at 34.132.194.35
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
export POSTGRES_URL="postgresql://postgres:pass@34.132.194.35:5432/postgres"
export DATABASE_URL="$POSTGRES_URL"

# Optional: CA certificate file for SSL/TLS connections to PostgreSQL
# Use if PostgreSQL is behind a proxy or uses self-signed certificates
# export POSTGRES_CA_FILE="/path/to/your/ca-cert.pem"

# ============================================================================
# ZEEK LOG READER CONFIGURATION (for separate VM)
# ============================================================================
# ============================================================================
# ZEEK REMOTE CONFIGURATION (for remote Zeek sensor VM at 35.222.249.202)
# ============================================================================
# SSH Host for remote Zeek sensor
export ZEEK_REMOTE_HOST="34.63.246.217"

# SSH Username for Zeek sensor VM
export ZEEK_REMOTE_USER="zauguste52"

# SSH Key file path (ED25519 key)
# This is the private key used to authenticate to the Zeek sensor VM
export ZEEK_SSH_KEY="/home/zauguste52/.ssh/id_ed25519"

# SSH Key passphrase (if key is encrypted, leave empty if not)
export ZEEK_SSH_PASSPHRASE=""

# Remote Zeek log directory path
export ZEEK_REMOTE_LOG_DIR="/opt/zeek/logs/current"

# ============================================================================
# ZEEK LOG READER CONFIGURATION (Legacy - for local Zeek on same VM)
# ============================================================================
# Directory where Zeek writes log files on the Zeek sensor VM
# Default: /opt/zeek/logs/current
export ZEEK_LOG_DIR="/opt/zeek/logs/current"

# Directory to move processed Zeek log files (optional)
export ZEEK_PROCESSED_DIR="/opt/zeek/logs/processed"

# How often to poll Zeek log directory for new files (in seconds)
export ZEEK_POLL_INTERVAL="10"

# ============================================================================
# SUPABASE/LEGACY CONFIGURATION (if still in use)
# ============================================================================
# Replace with your actual credentials and host
export SUPABASE_DB_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"
export SUPABASE_TABLE_NAME="host_telemetry"

# If your Supabase/PostgreSQL uses a CA certificate, set this path:
# export SUPABASE_CA_FILE="/path/to/your/supabase-ca.crt"

# ============================================================================
# KAFKA CONFIGURATION
# ============================================================================
# Replace with your Kafka broker address (e.g., 'kafka-host:9092')
export KAFKA_BROKER="76.10.21.246:9092"
export KAFKA_TOPIC="osquery_logs"

# If your Kafka uses SSL/TLS for security, set the paths to the certificate files:
# export KAFKA_CA_FILE="C:\kafka\config\ca-cert.pem"
# export KAFKA_CERT_FILE="C:\kafka\config\kafka-client-cert.pem"
# export KAFKA_KEY_FILE="C:\kafka\config\kafka-client-key.pem"

# ============================================================================
# AI API CONFIGURATION
# ============================================================================
export OPENAI_API_KEY="your_openai_api_key_here"
export GEMINI_API_KEY="your_gemini_api_key_here"

# ============================================================================
# NOTES FOR DEPLOYMENT ON SEPARATE VMS
# ============================================================================
# For the main application (current VM):
#   1. Set POSTGRES_URL to point to your PostgreSQL database VM
#   2. Ensure network connectivity to the PostgreSQL VM
#   3. Use strong passwords in production
#
# For the Zeek Log Reader (separate Zeek sensor VM):
#   1. Copy this configuration to the Zeek sensor VM
#   2. Set ZEEK_LOG_DIR to your Zeek installation's log directory
#   3. Ensure POSTGRES_URL points to the shared PostgreSQL database VM
#   4. Run: python -m backend.app.zeek_log_reader
#
# For production deployments:
#   1. Enable SSL/TLS for database connections
#   2. Use environment variable secrets management (e.g., AWS Secrets Manager)
#   3. Enable firewall rules to restrict database access
#   4. Use process managers (systemd, supervisor) for automatic restarts
#   5. Set up monitoring and alerting for the log reader service

