# Zeek Log Reader Configuration
# This configuration is used by zeek_log_reader.py to read Zeek logs and send to PostgreSQL

# ============================================================================
# ZEEK LOG CONFIGURATION
# ============================================================================

# Directory where Zeek writes log files
# On the Zeek sensor VM, this is typically /opt/zeek/logs/current
ZEEK_LOG_DIR=/opt/zeek/logs/current

# Directory to move processed log files to (optional)
# If set, processed files will be moved here to avoid reprocessing
ZEEK_PROCESSED_DIR=/opt/zeek/logs/processed

# How often to poll the Zeek log directory (in seconds)
ZEEK_POLL_INTERVAL=10

# ============================================================================
# POSTGRESQL CONFIGURATION FOR REMOTE VM
# ============================================================================

# PostgreSQL connection string - point this to the PostgreSQL VM
# Format: postgresql://username:password@host:port/database
# Update password to match your Postgres VM credentials
POSTGRES_URL=postgresql://postgres:pass@34.132.194.35:5432/cybercyte_db

# Optional: Path to CA certificate file for SSL/TLS connections
# If your PostgreSQL is behind a proxy or uses self-signed certs
# POSTGRES_CA_FILE=/path/to/ca-cert.pem

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# NOTES FOR DEPLOYMENT ON SEPARATE VM
# ============================================================================
# 1. Install Python 3.10+ and required packages (see requirements.txt)
# 2. Configure ZEEK_LOG_DIR to point to your Zeek installation's log directory
# 3. Configure POSTGRES_URL to point to the PostgreSQL instance on the database VM
# 4. Ensure network connectivity between the Zeek VM and PostgreSQL VM
# 5. For production, use strong passwords and enable SSL/TLS connections
# 6. Use a process manager like systemd or supervisor to keep the service running
# 7. Consider using rsyslog or similar to forward Zeek logs if the VM is remote
