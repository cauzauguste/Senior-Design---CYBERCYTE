FROM python:3.12-slim

WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the Streamlit app
COPY cybercyte/ /app/cybercyte/

# Create a startup script
RUN echo '#!/bin/bash\ncd /app\nstreamlit run cybercyte/Home.py --server.port=8501 --server.address=0.0.0.0' > /app/start.sh && chmod +x /app/start.sh

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["/app/start.sh"]
